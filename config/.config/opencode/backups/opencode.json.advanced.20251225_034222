{
  "$schema": "https://opencode.ai/config.json",
  "theme": "opencode",
  "autoupdate": "notify",
  "share": "manual",

  "model": "llama-cpp/bartowski_Qwen2.5-Coder-32B-Instruct-GGUF_Qwen2.5-Coder-32B-Instruct-Q4_K_M.gguf",
  "small_model": "llama-cpp/bartowski_Nemotron-Mini-4B-Instruct-GGUF_Nemotron-Mini-4B-Instruct-Q4_K_M.gguf",

  "default_agent": "build",

  "agent": {
    "build": {
      "description": "Full-featured development agent with all tools enabled",
      "temperature": 0.7,
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true,
        "grep": true,
        "glob": true,
        "list": true,
        "patch": true,
        "webfetch": true,
        "todowrite": true,
        "todoread": true,
        "skill": true
      },
      "permission": {
        "edit": "ask",
        "write": "ask",
        "bash": "ask"
      },
      "maxSteps": 50
    },
    "plan": {
      "description": "Planning and analysis agent - read-only mode for strategic thinking",
      "temperature": 0.2,
      "tools": {
        "read": true,
        "write": false,
        "edit": false,
        "bash": false,
        "grep": true,
        "glob": true,
        "list": true,
        "patch": false,
        "webfetch": true,
        "todowrite": true,
        "todoread": true,
        "skill": true
      },
      "maxSteps": 30
    },
    "review": {
      "description": "Code review agent focused on analysis and suggestions",
      "temperature": 0.3,
      "tools": {
        "read": true,
        "write": false,
        "edit": false,
        "bash": false,
        "grep": true,
        "glob": true,
        "list": true,
        "patch": false,
        "webfetch": true,
        "todowrite": true,
        "todoread": true
      },
      "maxSteps": 25
    },
    "debug": {
      "description": "Debugging agent with investigation capabilities",
      "temperature": 0.4,
      "tools": {
        "read": true,
        "write": false,
        "edit": false,
        "bash": true,
        "grep": true,
        "glob": true,
        "list": true,
        "patch": false,
        "webfetch": false,
        "todowrite": true,
        "todoread": true
      },
      "permission": {
        "bash": "ask"
      },
      "maxSteps": 40
    },
    "general": {
      "description": "General-purpose agent for research and multi-step tasks",
      "temperature": 0.6,
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true,
        "grep": true,
        "glob": true,
        "list": true,
        "webfetch": true,
        "todowrite": true,
        "todoread": true
      },
      "permission": {
        "edit": "ask",
        "write": "ask",
        "bash": "ask"
      },
      "maxSteps": 50
    },
    "explore": {
      "description": "Fast codebase exploration agent",
      "temperature": 0.3,
      "model": "llama-cpp/bartowski_Qwen2.5-Coder-7B-Instruct-GGUF_Qwen2.5-Coder-7B-Instruct-Q4_K_M.gguf",
      "tools": {
        "read": true,
        "write": false,
        "edit": false,
        "bash": false,
        "grep": true,
        "glob": true,
        "list": true,
        "patch": false,
        "webfetch": false,
        "todowrite": false,
        "todoread": true
      },
      "maxSteps": 20
    }
  },

  "tui": {
    "scroll_speed": 3,
    "scroll_acceleration": {
      "enabled": true
    }
  },

  "tools": {
    "read": true,
    "write": true,
    "edit": true,
    "bash": true,
    "grep": true,
    "glob": true,
    "list": true,
    "patch": true,
    "webfetch": true,
    "todowrite": true,
    "todoread": true,
    "skill": true,
    "lsp": false
  },

  "permission": {
    "edit": "ask",
    "bash": "ask",
    "write": "ask",
    "webfetch": "allow",
    "external_directory": "ask"
  },

  "provider": {
    "llama-cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Llama.cpp (local)",
      "options": {
        "baseURL": "http://localhost:11336/v1"
      },
      "models": {
        "bartowski_Nemotron-Mini-4B-Instruct-GGUF_Nemotron-Mini-4B-Instruct-Q4_K_M.gguf": {
          "name": "Nemotron Mini 4B (4K context) - Fast",
          "tools": true
        },
        "bartowski_Qwen2.5-Coder-7B-Instruct-GGUF_Qwen2.5-Coder-7B-Instruct-Q4_K_M.gguf": {
          "name": "Qwen2.5 Coder 7B (24K context) - Better",
          "tools": true
        },
        "bartowski_nvidia_Nemotron-3-Nano-30B-A3B-GGUF_nvidia_Nemotron-3-Nano-30B-A3B-Q4_K_M.gguf": {
          "name": "Nemotron Nano 30B (32K context) - MoE Reasoning",
          "tools": true
        },
        "bartowski_Qwen2.5-Coder-32B-Instruct-GGUF_Qwen2.5-Coder-32B-Instruct-Q4_K_M.gguf": {
          "name": "Qwen2.5 Coder 32B (32K context) - SOTA Dual GPU",
          "tools": true
        },
        "bartowski_DeepSeek-Coder-V2-Lite-Instruct-GGUF_DeepSeek-Coder-V2-Lite-Instruct-Q4_K_M.gguf": {
          "name": "DeepSeek Coder V2 Lite (32K context) - SOTA Dual GPU",
          "tools": true
        }
      }
    }
  }
}
