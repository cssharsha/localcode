.PHONY: help setup start stop restart status logs logs-llama logs-llama-live logs-router logs-follow build clean verify test gpu-check model-info backup restore use-nemotron use-qwen use-nemotron-nano use-qwen32b-dualgpu use-deepseek-dualgpu current-model opencode-model config-install config-uninstall config-status config-edit download-progress watch-startup

# Model selection (default: nemotron)
COMPOSE_FILE ?= docker-compose.yml

# Default target
help:
	@echo "OpenCode with llama.cpp - Available commands:"
	@echo ""
	@echo "Model Selection (Single GPU - CUDA - Nvidia only):"
	@echo "  make use-nemotron          - Switch to Nemotron-Mini-4B (4K context, fast)"
	@echo "  make use-qwen              - Switch to Qwen2.5-Coder-7B (24K context, better)"
	@echo ""
	@echo "Model Selection (Dual GPU - Vulkan - Nvidia + Intel Arc):"
	@echo "  make use-nemotron-nano     - Switch to Nemotron-3-Nano-30B (32K context, MoE)"
	@echo "  make use-qwen32b-dualgpu   - Switch to Qwen2.5-Coder-32B (32K context, SOTA)"
	@echo "  make use-deepseek-dualgpu  - Switch to DeepSeek-Coder-V2-Lite (32K context, SOTA)"
	@echo ""
	@echo "  make current-model         - Show which model llama-cpp is running"
	@echo "  make opencode-model        - Show which model OpenCode will use"
	@echo ""
	@echo "  make setup          - Initial setup (create directories, check prerequisites)"
	@echo "  make start          - Start all services"
	@echo "  make stop           - Stop all services"
	@echo "  make restart        - Restart all services"
	@echo "  make build          - Build containers"
	@echo "  make status         - Show service status"
	@echo ""
	@echo "  make logs              - View all logs"
	@echo "  make logs-llama        - View llama-cpp logs (last 100 lines)"
	@echo "  make logs-llama-live   - Follow llama-cpp logs in real-time"
	@echo "  make logs-router       - View router logs"
	@echo "  make logs-follow       - Follow all logs in real-time"
	@echo "  make download-progress - Monitor model download progress"
	@echo "  make watch-startup     - Watch startup with auto-refresh"
	@echo ""
	@echo "  make verify         - Verify the setup is working"
	@echo "  make test           - Test the API endpoint"
	@echo "  make model-info     - Show model information"
	@echo "  make gpu-check      - Check GPU status"
	@echo ""
	@echo "  make backup         - Backup configuration files"
	@echo "  make restore        - Restore configuration from backup"
	@echo "  make clean          - Stop services and remove volumes"
	@echo "  make clean-all      - Clean everything including downloaded models"
	@echo ""
	@echo "Configuration Management:"
	@echo "  make config-install   - Install OpenCode config to ~/.config/opencode (using stow)"
	@echo "  make config-uninstall - Remove OpenCode config symlinks"
	@echo "  make config-status    - Check configuration status"
	@echo "  make config-edit      - Edit OpenCode configuration"

# Initial setup
setup:
	@echo "Setting up directories..."
	@sudo mkdir -p /data/llama-models
	@sudo chown -R $(shell id -u):$(shell id -g) /data/llama-models
	@echo "Checking NVIDIA GPU..."
	@nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv || \
		(echo "Warning: NVIDIA GPU not detected or drivers not installed"; exit 1)
	@echo "Checking Docker..."
	@docker --version || (echo "Error: Docker not installed"; exit 1)
	@echo "Setup complete!"

# Start services
start: up
up:
	@echo "Starting services..."
	@docker compose up -d
	@echo "Services started!"
	@echo "Run 'make logs-follow' to monitor startup (model download on first run)"

# Stop services
stop: down
down:
	@echo "Stopping services..."
	@docker compose down
	@echo "Services stopped!"

# Restart services
restart:
	@echo "Restarting services..."
	@docker compose restart
	@echo "Services restarted!"

# Build containers
build:
	@echo "Building containers..."
	@docker compose build --no-cache
	@echo "Build complete!"

# Service status
status:
	@echo "Service Status:"
	@docker compose ps
	@echo ""
	@echo "Container Stats:"
	@docker stats --no-stream llama-cpp claude-router 2>/dev/null || echo "Containers not running"

# View logs
logs:
	@docker compose logs --tail=100

logs-llama:
	@docker logs --tail=100 llama-cpp

logs-llama-live:
	@echo "Following llama-cpp logs (Ctrl+C to exit)..."
	@docker logs -f --tail=50 llama-cpp 2>&1 | grep -v "^BUG in find_stowed_path" || true

download-progress:
	@echo "Monitoring model download progress..."
	@echo "This will show real-time download status and server startup"
	@echo "Press Ctrl+C to exit"
	@echo ""
	@if [ "$$(docker ps -q -f name=llama-cpp)" ]; then \
		docker exec -it llama-cpp sh -c ' \
			echo "Checking download status..."; \
			while true; do \
				if ls -lh /root/.cache/llama.cpp/*.gguf 2>/dev/null; then \
					echo ""; \
					echo "Model files:"; \
					ls -lh /root/.cache/llama.cpp/*.gguf 2>/dev/null; \
					echo ""; \
					if pgrep -f "llama-server" > /dev/null; then \
						echo "✓ Server is running!"; \
						break; \
					else \
						echo "Downloading... (refresh in 2s)"; \
					fi; \
				else \
					echo "Waiting for download to start..."; \
				fi; \
				sleep 2; \
				clear; \
			done \
		' 2>/dev/null || echo "Container not running"; \
	else \
		echo "❌ llama-cpp container is not running"; \
		echo "Start with: make start"; \
	fi

watch-startup:
	@echo "Watching startup process..."
	@echo "This shows log tail and refreshes every 2 seconds"
	@echo "Press Ctrl+C to exit"
	@echo ""
	@watch -n 2 -c 'docker logs --tail=30 llama-cpp 2>&1 | tail -20'

logs-router:
	@docker logs --tail=100 claude-router

logs-follow:
	@docker compose logs -f --tail=100

# Verify setup
verify:
	@echo "Verifying llama-cpp is running..."
	@curl -s http://localhost:11336/v1/models || (echo "Error: llama-cpp not responding"; exit 1)
	@echo "✓ llama-cpp is running"
	@echo ""
	@echo "Verifying router is running..."
	@docker logs claude-router 2>&1 | grep -q "started" && echo "✓ Claude router is running" || echo "⚠ Router may not be ready"
	@echo ""
	@echo "All services verified!"

# Test API endpoint
test:
	@echo "Testing llama-cpp API..."
	@curl -s http://localhost:11336/v1/chat/completions \
		-H "Content-Type: application/json" \
		-d '{"model": "Nemotron-Mini-4B-Instruct", "messages": [{"role": "user", "content": "Say hello"}], "max_tokens": 50}' \
		| jq '.' || (echo "Error: API test failed"; exit 1)

# Show model information
model-info:
	@echo "Available models:"
	@curl -s http://localhost:11336/v1/models | jq '.'
	@echo ""
	@echo "Model files in storage:"
	@ls -lh /data/llama-models/ 2>/dev/null || echo "No models downloaded yet"

# Check GPU status
gpu-check:
	@echo "NVIDIA GPU Status:"
	@nvidia-smi
	@echo ""
	@echo "GPU usage in llama-cpp container:"
	@docker exec llama-cpp nvidia-smi 2>/dev/null || echo "Container not running or GPU not accessible"

# Backup configuration
backup:
	@echo "Backing up configuration files..."
	@mkdir -p backups
	@cp docker-compose.yml backups/docker-compose.yml.backup.$$(date +%Y%m%d_%H%M%S)
	@cp router-config.json backups/router-config.json.backup.$$(date +%Y%m%d_%H%M%S)
	@cp opencode.json backups/opencode.json.backup.$$(date +%Y%m%d_%H%M%S)
	@echo "Backup created in ./backups/"
	@ls -lh backups/

# Restore from backup (uses most recent backup)
restore:
	@echo "Available backups:"
	@ls -lt backups/ | head -10
	@echo ""
	@echo "Restoring most recent backup..."
	@cp $$(ls -t backups/docker-compose.yml.backup.* | head -1) docker-compose.yml
	@cp $$(ls -t backups/router-config.json.backup.* | head -1) router-config.json
	@cp $$(ls -t backups/opencode.json.backup.* | head -1) opencode.json
	@echo "Configuration restored!"

# Clean up
clean:
	@echo "Stopping services and removing containers..."
	@docker compose down -v
	@echo "Clean complete! (model files preserved)"

clean-all: clean
	@echo "Removing model files..."
	@sudo rm -rf /data/llama-models/*
	@echo "All data cleaned!"

# Quick commands for common operations
pull-logs: logs-follow
watch-gpu:
	@watch -n 1 nvidia-smi

# First time setup - complete flow
first-run: setup start logs-follow

