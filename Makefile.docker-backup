# Configuration Management with GNU Stow
config-install:
	@echo "Installing OpenCode configuration to ~/.config/opencode..."
	@if ! command -v stow >/dev/null 2>&1; then \
		echo "❌ Error: GNU Stow is not installed"; \
		echo ""; \
		echo "Install with:"; \
		echo "  Ubuntu/Debian: sudo apt install stow"; \
		echo "  Arch Linux:    sudo pacman -S stow"; \
		echo "  macOS:         brew install stow"; \
		exit 1; \
	fi
	@mkdir -p ~/.config
	@if [ -d ~/.config/opencode ] && [ ! -L ~/.config/opencode/opencode.json ]; then \
		echo "⚠ Warning: ~/.config/opencode exists and is not managed by stow"; \
		echo "Creating backup..."; \
		mv ~/.config/opencode ~/.config/opencode.backup.$$(date +%Y%m%d_%H%M%S); \
		echo "✓ Backup created: ~/.config/opencode.backup.$$(date +%Y%m%d_%H%M%S)"; \
	fi
	@cd $$(pwd) && stow -v -t ~ -d . config 2>&1 | grep -v "^BUG in find_stowed_path" || true
	@echo ""
	@echo "✓ OpenCode configuration installed!"
	@echo ""
	@echo "Configuration location:"
	@echo "  Source: $$(pwd)/config/.config/opencode/"
	@echo "  Target: ~/.config/opencode/ (symlinked)"
	@echo ""
	@echo "Files managed:"
	@ls -la ~/.config/opencode/ | grep "^l" | awk '{print "  " $$9 " -> " $$11}'
	@echo ""
	@echo "To edit: make config-edit"

config-uninstall:
	@echo "Uninstalling OpenCode configuration from ~/.config/opencode..."
	@if ! command -v stow >/dev/null 2>&1; then \
		echo "❌ Error: GNU Stow is not installed"; \
		exit 1; \
	fi
	@cd $$(pwd) && stow -v -D -t ~ -d . config 2>&1 | grep -v "^BUG in find_stowed_path" || true
	@echo "✓ OpenCode configuration uninstalled!"
	@echo ""
	@echo "Note: Original files still exist in $$(pwd)/config/.config/opencode/"

config-status:
	@echo "OpenCode Configuration Status:"
	@echo ""
	@echo "Source directory:"
	@echo "  $$(pwd)/config/.config/opencode/"
	@if [ -f config/.config/opencode/opencode.json ]; then \
		echo "  ✓ opencode.json exists"; \
	else \
		echo "  ❌ opencode.json missing"; \
	fi
	@if [ -f config/.config/opencode/.opencode/instructions.md ]; then \
		echo "  ✓ .opencode/instructions.md exists"; \
	else \
		echo "  ❌ .opencode/instructions.md missing"; \
	fi
	@echo ""
	@echo "Target directory (~/.config/opencode/):"
	@if [ -L ~/.config/opencode ]; then \
		echo "  ✓ Managed by stow (directory symlinked)"; \
		echo "  ✓ opencode -> $$(readlink ~/.config/opencode)"; \
	elif [ -d ~/.config/opencode ]; then \
		if [ -L ~/.config/opencode/opencode.json ]; then \
			echo "  ✓ Managed by stow (files symlinked)"; \
			echo "  ✓ opencode.json -> $$(readlink ~/.config/opencode/opencode.json)"; \
		elif [ -f ~/.config/opencode/opencode.json ]; then \
			echo "  ⚠ Not managed by stow (regular file)"; \
			echo "  ℹ Run 'make config-install' to manage with stow"; \
		else \
			echo "  ⚠ Directory exists but opencode.json missing"; \
		fi; \
	else \
		echo "  ❌ Not installed"; \
		echo "  ℹ Run 'make config-install' to install"; \
	fi
	@echo ""
	@if command -v stow >/dev/null 2>&1; then \
		echo "GNU Stow: ✓ Installed ($$(stow --version | head -1))"; \
	else \
		echo "GNU Stow: ❌ Not installed"; \
	fi

config-edit:
	@if [ -n "$$EDITOR" ]; then \
		$$EDITOR config/.config/opencode/opencode.json; \
	elif command -v vim >/dev/null 2>&1; then \
		vim config/.config/opencode/opencode.json; \
	elif command -v nano >/dev/null 2>&1; then \
		nano config/.config/opencode/opencode.json; \
	else \
		echo "No editor found. Please set EDITOR environment variable or install vim/nano"; \
		exit 1; \
	fi
	@echo ""
	@echo "Configuration updated in: $$(pwd)/config/.config/opencode/opencode.json"
	@if [ -L ~/.config/opencode ]; then \
		echo "✓ Changes are automatically reflected in ~/.config/opencode/ (symlinked)"; \
	else \
		echo "⚠ Run 'make config-install' to sync changes to ~/.config/opencode/"; \
	fi

opencode-model:
	@echo "OpenCode Model Configuration:"
	@echo ""
	@OPENCODE_MODEL=$$(jq -r '.model // "not set"' ~/.config/opencode/opencode.json 2>/dev/null); \
	if [ "$$OPENCODE_MODEL" = "not set" ] || [ -z "$$OPENCODE_MODEL" ]; then \
		echo "  ❌ No model configured in OpenCode"; \
		echo "  ℹ Run 'make use-<model>' to set up"; \
	else \
		echo "  ✓ Configured model: $$OPENCODE_MODEL"; \
		MODEL_NAME=$$(echo $$OPENCODE_MODEL | sed 's/.*bartowski_//; s/_GGUF.*//; s/_/ /g'); \
		echo "  ℹ Friendly name: $$MODEL_NAME"; \
	fi
	@echo ""
	@RUNNING_MODEL=$$(curl -s http://localhost:11336/v1/models 2>/dev/null | jq -r '.data[0].id // "not running"'); \
	OPENCODE_MODEL=$$(jq -r '.model // "not set"' ~/.config/opencode/opencode.json 2>/dev/null | sed 's/llama-cpp\///'); \
	if [ "$$RUNNING_MODEL" = "$$OPENCODE_MODEL" ]; then \
		echo "  ✓ OpenCode config matches running model"; \
	elif [ "$$RUNNING_MODEL" = "not running" ]; then \
		echo "  ⚠ llama-cpp is not running"; \
		echo "  ℹ Run 'make start' to start services"; \
	else \
		echo "  ⚠ MISMATCH DETECTED!"; \
		echo "  OpenCode expects: $$OPENCODE_MODEL"; \
		echo "  Actually running: $$RUNNING_MODEL"; \
		echo ""; \
		echo "  ℹ Run 'make use-<model>' to sync both"; \
	fi
