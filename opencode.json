{
  "$schema": "https://opencode.ai/config.json",
  "tui": {
    "scroll_speed": 3,
    "scroll_acceleration": {
      "enabled": true
    }
  },
  "tools": {
    "write": false,
    "bash": false
  },
  "permission": {
    "edit": "ask",
    "bash": "ask"
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11336/v1"
      },
      "models": {
        "qwen2.5-coder:14b-16k": {
          "name": "Qwen 2.5 14b 16k",
          "tools": true
        },
        "qwen3:8b-16k": {
          "name": "Qwen 3 8b 16k",
          "tools": true
        }
      }
    }
  }
}
