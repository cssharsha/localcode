# Use a CUDA base image
FROM nvidia/cuda:12.2.0-devel-ubuntu22.04

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHON_VERSION=3.10

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python$PYTHON_VERSION \
        python3-pip \
        git \
        curl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Add a symlink for 'python' to point to the installed python version
RUN ln -s /usr/bin/python$PYTHON_VERSION /usr/bin/python

# Install vLLM
RUN pip install vllm

# Expose the default vLLM port
EXPOSE 8000

# Set the entrypoint for the vLLM API server
ENTRYPOINT ["python", "-m", "vllm.entrypoints.api_server"]
